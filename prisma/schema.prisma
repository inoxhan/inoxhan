// İnoxhan — teklif toplama odaklı ürün kataloğu veri modeli
// Postgres (Neon; dev = Neon dev branch, prod = main branch).
// Taşınabilirlik için enum yerine String + zod, Json yerine String (JSON.stringify)
// yaklaşımı bilinçli olarak korunur (SQLite döneminden gelen sözleşme).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon pooled (-pooler) — uygulama trafiği
  directUrl = env("DIRECT_URL") // Neon direct — migrate/seed/import
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  order     Int       @default(0)
  imagePath String?
  products  Product[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Product {
  id         String            @id @default(cuid())
  sku        String            @unique
  name       String
  slug       String            @unique
  model      String?
  shortDesc  String?
  useAreas   String?           // "İnşaat, Mobilya, Tesisat" — virgüllü liste
  seoTitle   String?
  seoDesc    String?
  isActive   Boolean           @default(true)
  categoryId String
  brandId    String?
  category   Category          @relation(fields: [categoryId], references: [id])
  brand      Brand?            @relation(fields: [brandId], references: [id])
  specs      ProductSpec[]
  images     ProductImage[]
  drawings   ProductDrawing[]
  documents  ProductDocument[]
  quoteItems QuoteItem[]
  variants   Variant[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([categoryId])
  @@index([brandId])
}

/// Ölçü/kalite seviyesinde satış birimi — Excel tam katalogundan içe aktarılır
/// (scripts/import-varyantlar.ts, ~6.750 satır). Product AİLE seviyesidir ("DIN 84");
/// varyantlar site sayfası üretmez, yalnız hızlı teklif seçicisinde aranır.
model Variant {
  id          String      @id @default(cuid())
  code        String      @unique // Excel "Ürün Kodu": "084202 005"
  groupCode   String // Excel "Grup Kodu": "VİDA", "SOMUN"…
  dinNorm     String // Excel "DIN Normu" (ham): "DIN 84"
  description String // "INOX SİLİNDİR BAŞ METRİK VİDA M2x5 A2"
  quality     String? // açıklama sonundan ayrıştırılan "A2" | "A4"
  isActive    Boolean     @default(true) // --prune: dosyadan düşen kodlar pasifleşir
  productId   String? // dinNorm → Product.sku eşleşmesi; eşleşmezse null
  product     Product?    @relation(fields: [productId], references: [id])
  quoteItems  QuoteItem[]

  @@index([productId])
  @@index([dinNorm])
}

model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  key       String // "Malzeme", "Ölçü", "Kaplama", "Norm"
  value     String // "A2 Paslanmaz", "M8x40", "DIN 933"
  order     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([key, value])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  basePath  String // "media/products/inx-cv-0001" → -sm/-md/-lg .avif/.webp türevleri
  alt       String
  isMain    Boolean @default(false)
  order     Int     @default(0)
  width     Int
  height    Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// Katalog PDF'inden çıkarılan teknik çizim ve ölçü tablosu görselleri.
/// ProductImage ile aynı `{basePath}-{sm|md|lg}.{avif|webp}` sözleşmesi + `-full.webp`
/// (büyüt bağlantısı). Ürün fotoğrafından ayrı tutulur; galeride görünmez.
model ProductDrawing {
  id        String  @id @default(cuid())
  productId String
  kind      String // "cizim" (teknik çizim) | "tablo" (ölçü tablosu)
  basePath  String // "media/technical/din-933-cizim"
  alt       String
  width     Int
  height    Int
  order     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, kind])
  @@index([productId])
}

model ProductDocument {
  id        String  @id @default(cuid())
  productId String
  title     String // "Teknik Föy (PDF)"
  filePath  String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Customer {
  id         String         @id @default(cuid())
  name       String
  company    String?
  phone      String         @unique // normalize +905XXXXXXXXX — tekilleştirme anahtarı
  email      String?
  address    String? // kargo adresi — hızlı teklif formundan gelir
  taxOrTcNo  String? // vergi no (şirket) / TC no (birey) — YALNIZ panelden, sipariş aşamasında
  createdAt  DateTime       @default(now())
  quotes     QuoteRequest[]
}

model QuoteRequest {
  id             String      @id @default(cuid())
  status         String      @default("YENI") // YENI | BEKLEYEN | CEVAPLANAN | SIPARIS (zod korumalı)
  note           String?
  attachmentPath String? // "bana bu ürün lazım" fotoğrafı (özel depolama)
  source         String      @default("form") // form | product | hero | floating | liste
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])
  items          QuoteItem[]
  attachments    QuoteAttachment[]
  createdAt      DateTime    @default(now()) // geçen süre sayacının kaynağı
  respondedAt    DateTime? // fiyat verildiği an — 48 saatlik kayıp sayacı buradan başlar
  orderedAt      DateTime? // sipariş damgası; boşsa ve 48 saat geçtiyse sonuç "Fiyat tutmadı"

  @@index([status, createdAt])
  @@index([createdAt]) // aylık rapor aralık sorgusu ([status, createdAt] öneki uymaz)
}

model QuoteItem {
  id             String       @id @default(cuid())
  quoteRequestId String
  productId      String? // aile bağlantısı (varyant üzerinden veya doğrudan)
  variantId      String? // ölçü varyantı — hızlı teklif seçicisinden gelir
  freeText       String? // "8'lik dübel, siyah" — katalogda olmayan ihtiyaç
  quantity       Int          @default(1)
  unit           String       @default("adet") // adet | kutu | paket
  quality        String? // A2 (AISI 304) | A4 (AISI 316) — zod korumalı
  order          Int          @default(0) // sepetteki kalem sırası
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  product        Product?     @relation(fields: [productId], references: [id])
  variant        Variant?     @relation(fields: [variantId], references: [id])

  // Aylık rapor kalem birleştirmeleri bu üç yoldan geçer
  @@index([quoteRequestId])
  @@index([productId])
  @@index([variantId])
}

/// Dosya kanalının (1-3 dosya) ekleri. Eski tek dosyalı akışın
/// QuoteRequest.attachmentPath alanı geriye uyum için aynen durur.
model QuoteAttachment {
  id             String       @id @default(cuid())
  quoteRequestId String
  path           String // "uploads/..." (disk) veya Vercel Blob pathname'i
  order          Int          @default(0)
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  @@index([quoteRequestId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String // constants.ts EVENT_TYPES
  payload   String   @default("{}") // JSON string (SQLite uyumu)
  sessionId String? // anonim cookie id
  path      String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

model AdminUser {
  id           String @id @default(cuid())
  username     String @unique
  passwordHash String // scrypt$N$salt$hash
}

model Setting {
  key   String @id // notify_email | whatsapp_number | crm_webhook_url | crm_webhook_secret
  value String
}
